NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Optional: when omitted, the API uses a local JSON data store for development.
MONGO_URI=

# Optional SMTP settings for contact and password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Blog Platform <no-reply@example.com>"

# Optional external media base URL, for example a CDN or Cloudinary folder.
PUBLIC_MEDIA_URL=
